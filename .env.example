# Local: la base de docker-compose.yml. En el servidor, ~/app/.env.app.
DATABASE_URL=postgres://restaurante:restaurante@127.0.0.1:54329/restaurante

# Sólo en el servidor, para el contenedor de Postgres.
POSTGRES_USER=restaurante
POSTGRES_PASSWORD=cambiar
POSTGRES_DB=restaurante

# Las instala el panel (sección 13.3). En local, el simulador: npm run mails:simulado
BELAY_API_KEY=blay_...
BELAY_API_URL=http://127.0.0.1:9096

# La URL definitiva del sistema desde el primer deploy (sección 8): con la IP,
# el login rebota aunque el certificado esté bien.
BETTER_AUTH_URL=https://restaurante.belay.agency
# openssl rand -base64 48
BETTER_AUTH_SECRET=
