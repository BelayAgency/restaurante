{
  "name": "restaurante",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "tipos": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generar": "drizzle-kit generate",
    "db:migrar": "node --env-file=.env scripts/dist/migrar.cjs",
    "build:scripts": "esbuild scripts/migrar.ts scripts/sembrar.ts --bundle --platform=node --target=node24 --format=cjs --outdir=scripts/dist --out-extension:.js=.cjs --external:@node-rs/argon2",
    "mails:simulado": "node scripts/mails-simulado.mjs",
    "db:sembrar": "node --env-file=.env scripts/dist/sembrar.cjs"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "better-auth": "^1.7.14",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "drizzle-orm": "^0.45.4",
    "konva": "^10.9.0",
    "lucide-react": "^1.63.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-konva": "^19.3.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
